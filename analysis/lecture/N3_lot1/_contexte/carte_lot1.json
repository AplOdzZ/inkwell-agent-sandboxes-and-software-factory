   "levier": {
    "valeur": true,
    "pourquoi": "Ici se construit la ligne de commande de Pi (--tools, -e extensions, --thinking, --system-prompt, --session-id) ; changer PI_PATH/PI_MODELS_PATH ou les flags passes a Pi change ce que les agents peuvent faire. Le reste (parsing des evenements) est de la mecanique."
   },
   "fonctions_cles": [
    {
     "nom": "_pi_catalog",
     "lignes": "43-64",
     "ce_quelle_fait": "Lance `pi --list-models` (cache lru) et parse fournisseur / modele / fenetre de contexte."
    },
    {
     "nom": "resolve_model",
     "lignes": "67-90",
     "ce_quelle_fait": "Transforme un motif de modele en (fournisseur, id) exact ; ValueError si introuvable ou ambigu."
    },
    {
     "nom": "context_window",
     "lignes": "108-117",
     "ce_quelle_fait": "Lit ~/.pi/agent/models.json (PI_MODELS_PATH) puis le catalogue pour trouver la fenetre de contexte."
    },
    {
